<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Project Contract</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; }
        .header { text-align: center; margin-bottom: 30px; }
        .section { margin-bottom: 20px; }
        .signature { margin-top: 50px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Project Contract</h1>
        <p>Date: {{date}}</p>
    </div>

    <div class="section">
        <h2>Parties</h2>
        <p><strong>Client:</strong> {{client.name}}</p>
        <p><strong>Company:</strong> {{client.company}}</p>
        <p><strong>Email:</strong> {{client.email}}</p>
        <p><strong>Phone:</strong> {{client.phone}}</p>
    </div>

    <div class="section">
        <h2>Project Details</h2>
        <p><strong>Project Name:</strong> {{project.name}}</p>
        <p><strong>Description:</strong> {{project.description}}</p>
        <p><strong>Start Date:</strong> {{project.start_date}}</p>
        <p><strong>End Date:</strong> {{project.end_date}}</p>
        <p><strong>Budget:</strong> ${{project.budget}}</p>
    </div>

    <div class="section">
        <h2>Terms and Conditions</h2>
        <ol>
            <li>The project will be completed according to the specifications outlined above.</li>
            <li>Payment will be made according to the agreed schedule.</li>
            <li>Any changes to the project scope must be agreed upon in writing.</li>
            <li>The client agrees to provide necessary information and materials in a timely manner.</li>
        </ol>
    </div>

    <div class="signature">
        <p>Client Signature: ___________________________</p>
        <p>Date: ___________________________</p>
    </div>
</body>
</html> 